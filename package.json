{
  "name": "feishu-codex-bridge",
  "version": "0.1.1",
  "description": "Self-hosted Feishu/Lark remote control bridge for Codex Desktop",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzeli7/feishu-codex-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/chengzeli7/feishu-codex-bridge/issues"
  },
  "homepage": "https://github.com/chengzeli7/feishu-codex-bridge#readme",
  "type": "module",
  "bin": {
    "feishu-codex-bridge": "bin/feishu-codex-bridge.mjs"
  },
